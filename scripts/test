#!/usr/bin/env bash
# Ground-truth test step.
#
# There is no ScalaTest/munit suite yet (nothing to assert against beyond
# "does it compile/link"). Ground truth for this repo is therefore:
# (1) everything compiles/links, and
# (2) the CLI's registry -> file-write pipeline actually works end to end
# against the real built registry. A slower, deeper check — publishing
# `core` and compiling the written files in a throwaway sbt project — is
# documented in AGENTS.md but not run here on every pass (it's slow; do it
# by hand before anything registry/CLI-shaped ships).
set -euo pipefail
cd "$(dirname "$0")/.."
REPO_ROOT="$(pwd)"

"$REPO_ROOT/scripts/build"

echo "test: registry build"
(cd apps/web && node scripts/build-registry.mjs)

echo "test: CLI init + add smoke test"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"
node "$REPO_ROOT/packages/cli/dist/index.js" init \
  --registry "$REPO_ROOT/apps/web/public/registry" \
  --preset buFywLo \
  --project-name test-app \
  --group org.example.test
for f in README.md build.sbt project/plugins.sbt packages/shared/src/main/scala/org/example/test/shared/Shared.scala packages/ui/package.json packages/ui/src/main/scala/org/example/test/ui/Main.scala packages/ui/src/main/scala/shadcnscalajs/core/CommonAttrs.scala packages/services/src/main/scala/org/example/test/services/Services.scala; do
  test -f "$f" || { echo "test: missing scaffold file $f" >&2; exit 1; }
done
test -f packages/ui/src/styles/tokens.css || { echo "test: missing theme tokens.css" >&2; exit 1; }
ls packages/ui/src/styles/pack-*.css >/dev/null 2>&1 || { echo "test: missing style pack css" >&2; exit 1; }
grep -q 'tokens.css' packages/ui/src/styles/globals.css || { echo "test: globals.css does not import tokens.css" >&2; exit 1; }
grep -q 'stylePack' shadcn-scalajs.json || { echo "test: missing stylePack in config" >&2; exit 1; }
grep -q '~ui/fastLinkJS' scripts/run-scalajs-watch.mjs || { echo "test: scaffold dev command does not watch Scala sources" >&2; exit 1; }
node "$REPO_ROOT/packages/cli/dist/index.js" add button badge dialog accordion dropdown-menu
# Exercise the composed wrappers and their transitive registry deps in a real consumer build.
node "$REPO_ROOT/packages/cli/dist/index.js" add alert-dialog carousel data-table input-group navigation-menu sonner

for f in Button Badge Dialog Accordion DropdownMenu; do
  test -f "packages/ui/src/main/scala/shadcnscalajs/ui/$f.scala" || { echo "test: missing $f.scala" >&2; exit 1; }
done

echo "test: block install (login-01) + transitive component resolution"
node "$REPO_ROOT/packages/cli/dist/index.js" add login-01

for f in Login01 LoginForm; do
  test -f "packages/ui/src/main/scala/shadcnscalajs/blocks/login01/$f.scala" ||
    { echo "test: missing blocks/login01/$f.scala" >&2; exit 1; }
done

# Declared deps (button, card, input, field) plus Label, which is only reachable
# via field's own registryDependencies — so this also proves a multi-level walk.
for f in Button Card Input Field Label; do
  test -f "packages/ui/src/main/scala/shadcnscalajs/ui/$f.scala" ||
    { echo "test: missing transitive ui/$f.scala" >&2; exit 1; }
done

echo "test: generated scaffold compiles and links"
sbt "ui/compile" "services/compile"
npm install
npm run build

echo "test: consumer-owned Web Component build"
node "$REPO_ROOT/packages/cli/dist/index.js" build-wc
grep -q 'ScCard.register()' packages/webcomponents/src/main/scala/shadcnscalajs/webcomponents/Main.scala || { echo "test: installed card wrapper was not registered" >&2; exit 1; }
for component in ScAlertDialog ScCarousel ScDataTable ScInput ScInputGroup ScTextarea ScNavigationMenu ScSonner; do
  grep -q "$component.register()" packages/webcomponents/src/main/scala/shadcnscalajs/webcomponents/Main.scala || { echo "test: missing consumer wrapper $component" >&2; exit 1; }
done
for f in packages/ui/public/sc-components.js packages/ui/public/sc-components.css packages/ui/public/sc-document.css packages/ui/public/sc-components-loader.js packages/ui/public/styles/pack-lyra.css; do
  test -s "$f" || { echo "test: missing Web Component asset $f" >&2; exit 1; }
done
# The independent bundle must actually relink the consumer's edited Scala UI source.
node -e 'const fs = require("node:fs"); const file = "packages/ui/src/main/scala/shadcnscalajs/ui/Badge.scala"; fs.writeFileSync(file, fs.readFileSync(file, "utf8").replace("badge cn-badge group/badge", "badge cn-badge consumer-edited-badge group/badge"));'
npm run build:webcomponents
grep -q 'consumer-edited-badge' packages/ui/public/sc-components.js || { echo "test: Web Component bundle ignored consumer Badge.scala edit" >&2; exit 1; }
npm run build
test -s packages/ui/dist/sc-components.js || { echo "test: Vite did not copy Web Component assets" >&2; exit 1; }
test -s packages/ui/dist/sc-document.css || { echo "test: Vite did not copy isolated document CSS" >&2; exit 1; }

echo "test: default Web Component bundle packaging"
(cd "$REPO_ROOT/packages/wc-bundle" && npm run build)
for f in index.js sc-components.js sc-components.css sc-document.css styles/pack-nova.css; do
  test -s "$REPO_ROOT/packages/wc-bundle/dist/$f" || { echo "test: missing default bundle asset $f" >&2; exit 1; }
done

echo "test: OK"
